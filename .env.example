# Optional. Dawn Patrol builds and runs with none of these set.
# Development shows a labeled "Advertisement" placeholder when a placement
# has no valid client and slot. Production renders nothing.
# NEXT_PUBLIC_* values are read at build time. ADS_TXT is read when /ads.txt is requested.

# AdSense publisher id, including the ca- prefix. 16 digits.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Responsive display ad units, digits only. The shared slot is the fallback.
# Set a placement slot to give that screen its own unit.
# Do not use anchor, vignette, or interstitial units.
# NEXT_PUBLIC_ADSENSE_SLOT=
# NEXT_PUBLIC_ADSENSE_SLOT_TODAY=
# NEXT_PUBLIC_ADSENSE_SLOT_GAME=
# NEXT_PUBLIC_ADSENSE_SLOT_SEASONS=
# NEXT_PUBLIC_ADSENSE_SLOT_PLACES=

# Optional full body for /ads.txt and /app-ads.txt.
# One record per line. Overrides the line generated from the client id.
# ADS_TXT=google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
